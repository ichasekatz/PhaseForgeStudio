# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Python
*.py text eol=lf
*.pyi text eol=lf

# Web
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf

# Config
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.cff text eol=lf

# Binary
*.png binary
*.jpg binary
*.pkl binary
